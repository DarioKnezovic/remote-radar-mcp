# Postgres from docker-compose.yml (this is also the default when unset).
DATABASE_URL=postgres://remote_radar:remote_radar@localhost:5433/remote_radar

# debug | info | warn | error — logs go to stderr.
LOG_LEVEL=info

# Only for `npm run test:db`: integration tests create and drop a temporary schema here.
TEST_DATABASE_URL=postgres://remote_radar:remote_radar@localhost:5433/remote_radar
