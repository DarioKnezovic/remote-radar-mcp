{
  "name": "remote-radar-mcp",
  "version": "0.3.0",
  "description": "Find, compare and track remote developer jobs from official public job APIs, in a local web app or from Claude (MCP server). Never auto-applies.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "remote-radar-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "migrations",
    "boards.default.json",
    "profile.example.json"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://remote_radar:remote_radar@localhost:5433/remote_radar} vitest run",
    "test:coverage": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://remote_radar:remote_radar@localhost:5433/remote_radar} vitest run --coverage",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "web:dev": "npm run build && npm run dev -w web",
    "web:build": "npm run build && npm run build -w web",
    "web:start": "npm run start -w web",
    "web:e2e": "npm run web:build && npm run test:e2e -w web",
    "app:up": "docker compose up -d --build --wait",
    "app:down": "docker compose down",
    "demo:seed": "tsx scripts/demo-seed.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jobs",
    "remote"
  ],
  "author": "Dario Knezović",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
